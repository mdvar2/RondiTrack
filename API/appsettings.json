{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "https://api.ronditrack.local",
    "Audience": "ronditrack-web",
    "AccessTokenMinutes": 5,
    "ClockSkewSeconds": 30,
    "RefreshTokenDays": 7
  }
}
