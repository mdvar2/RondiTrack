# Copy to .env.local (git-ignored) and fill in. Both values are server-only:
# neither starts with NEXT_PUBLIC_, so Next.js never puts them in browser code.

# The ASP.NET Core API. Only the Next.js server calls it.
# http://localhost:5101 for `dotnet run` (http launch profile);
# http://localhost:8080 for the Docker Compose API (`docker compose up`).
API_BASE_URL=http://localhost:5101

# 32 random bytes, base64-encoded. Encrypts the session cookie (jose dir + A256GCM).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Optional: export traces (Assignment 9.3 Part 2). Unset = spans are still made,
# so failure references still work, but nothing is sent anywhere.
# Local Jaeger (docker compose --profile observability up -d jaeger):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ronditrack-web

# Demo and test environments ONLY; never in production (the server refuses to
# start if RONDITRACK_DEMO_FAULTS is set outside demo/test). See the root README,
# "Simulated post-commit response failure".
# RONDITRACK_ENVIRONMENT=demo
# RONDITRACK_DEMO_FAULTS=enabled
# RONDITRACK_DEMO_FAULT_SECRET=
# RONDITRACK_DEMO_FAULT_ACCOUNTS=demo.treasurer@example.test
